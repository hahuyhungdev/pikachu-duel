{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pikachu-duel-room",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "DuelRoom" }]
  },
  // SQLite-backed Durable Objects are the ones available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DuelRoom"] }]
}
